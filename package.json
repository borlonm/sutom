{
  "name": "sutom",
  "version": "1.0.0",
  "description": "Jeu de lettres en ligne (et en français)",
  "main": "js/main.js",
  "dependencies": {
    "@types/express": "^4.17.13",
    "better-sqlite3": "^11.10.0",
    "express": "^4.17.2",
    "readline-sync": "^1.4.10",
    "requirejs": "^2.3.6",
    "typescript": "^4.5.4",
    "@types/better-sqlite3": "^9.6.0"
  },
  "devDependencies": {
    "ts-node-dev": "^1.1.8",
    "tsc-watch": "^4.6.0"
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.serveur.json",
    "test": "npm run build && node --test \"dist/serveur/tests/*.test.js\"",
    "start": "npm run build && node dist/serveur/server.js",
    "start:dev": "npm run build && node dist/serveur/server.js & tsc-watch",
    "start:prod": "node dist/serveur/server.js"
  },
  "keywords": [
    "wordle",
    "letters",
    "word",
    "word game"
  ],
  "author": "JonathanMM <jonathanmm@free.fr>",
